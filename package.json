{
  "name": "censortracker",
  "version": "21.0.0",
  "description": "|",
  "author": "Censor Tracker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:chrome": "wxt build -b chrome --mv3 --mode development",
    "build:firefox": "wxt build -b firefox --mv2 --mode development",
    "build:chrome:prod": "wxt build -b chrome --mv3",
    "build:firefox:prod": "wxt build -b firefox --mv2",
    "build:firefox:modern": "CT_FIREFOX_MODERN=1 wxt build -b firefox --mv2",
    "release:firefox": "node tasks/release.cjs firefox",
    "release:firefox:modern": "node tasks/release.cjs firefox modern",
    "release:chrome": "node tasks/release.cjs chrome",
    "release": "node tasks/release.cjs firefox && node tasks/release.cjs chrome",
    "lint": "eslint --max-warnings=0 ./src/",
    "test": "node --test tests/*.test.cjs tests/services.cjs",
    "test:reproducible": "node tasks/reproducible.cjs",
    "test:services": "node --test tests/services.cjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser-*.cjs",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "locales:fmt": "node tasks/fixLocales.cjs",
    "locales:check": "node tasks/lintLocales.cjs",
    "typecheck": "node tasks/css-types.cjs && tsc --noEmit",
    "dev": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv2",
    "postinstall": "wxt prepare && node tasks/css-types.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "axios": "^1.20.0",
    "preact": "^11.0.1",
    "preact-router": "4.1.2",
    "tldts": "^7.4.18",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-modules-commonjs": "^7.28.0",
    "@babel/plugin-transform-react-jsx": "^7.28.0",
    "@babel/preset-typescript": "^7.28.0",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/preact": "^3.2.4",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/validator": "^13.15.10",
    "c12": "^3.3.4",
    "chrome-types": "^0.1.453",
    "cssnano": "^7.1.9",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "jszip": "3.10.1",
    "pixelmatch": "^8.0.0",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "postcss-modules": "^6.0.1",
    "sass": "^1.105.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "terser": "^5.43.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.0",
    "web-ext": "^10.6.0",
    "wxt": "0.21.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/censortracker/censortracker.git"
  },
  "bugs": {
    "url": "https://github.com/censortracker/censortracker/issues"
  },
  "homepage": "https://github.com/censortracker/censortracker#readme",
  "engines": {
    "node": ">=24.15.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "cheerio": {
      "encoding-sniffer": "^1.0.2"
    }
  }
}
